{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbit project snapshot v3",
  "description": "A point-in-time snapshot. Missing stage, progress or timestamps are unknown, not zero. Cloud tasks are distinct from agents. An explicit project brief has its own source and observation time, independent of cloud polling. Bundled examples are illustrative demo data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generatedAt",
    "projects"
  ],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      },
      "maxItems": 12,
      "minItems": 0
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "status",
        "currentTask"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "working",
            "waiting",
            "completed"
          ]
        },
        "currentTask": {
          "type": "string"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "createdAt",
        "highlights"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "detail",
        "isComplete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "isComplete": {
          "type": "boolean"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "briefUpdatedAt": { "type": "null" },
            "briefSource": { "type": "null" }
          }
        },
        {
          "required": ["briefUpdatedAt", "briefSource"],
          "properties": {
            "briefUpdatedAt": { "type": "string" },
            "briefSource": { "type": "string" }
          }
        }
      ],
      "required": [
        "id",
        "name",
        "subtitle",
        "symbol",
        "tintHex",
        "agents",
        "reports",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "tintHex": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{6}$"
        },
        "stage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "discovery",
            "development",
            "testing",
            "delivery",
            null
          ]
        },
        "progress": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          },
          "maxItems": 12
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/report"
          },
          "maxItems": 50
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "maxItems": 50
        },
        "source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "briefUpdatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "briefSource": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "cloudTasks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/cloudTask"
          },
          "maxItems": 100
        }
      }
    },
    "cloudTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
